# VPS Deployment Environment Variables

# Domains (MUST be HTTPS for Google SSO to work!)
# Note: Google SSO does NOT allow IP addresses for production redirect URIs.
# If you don't have a domain name, you can use nip.io as a free trick:
# Replace 1.2.3.4 with your Hostinger VPS IP address
FRONTEND_DOMAIN=frontend.1.2.3.4.nip.io
BACKEND_DOMAIN=backend.1.2.3.4.nip.io

# Google OAuth Credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_ALLOWED_CLIENT_IDS=your-google-client-id

# IMPORTANT: Make sure these match the FRONTEND_DOMAIN exactly and start with https://
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS=https://frontend.1.2.3.4.nip.io/account/login/gmail,https://frontend.1.2.3.4.nip.io/account/register/gmail,https://frontend.1.2.3.4.nip.io/rest/oauth2-credential/callback
