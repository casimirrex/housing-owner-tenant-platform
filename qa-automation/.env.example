# ─── QA automation env file ──────────────────────────────────────────────────
# Copy to .env.local, .env.staging, .env.production. Pick which one to use:
#   TEST_ENV=staging npm test    → loads .env.staging
#   TEST_ENV=local   npm test    → loads .env.local  (default)

# Target URLs
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# Seeded test users — match backend/src/main/resources/data.sql
TENANT_EMAIL=aarav@example.com
TENANT_PASSWORD=StrongPassword@123

OWNER_EMAIL=rohit.mehta@example.com
OWNER_PASSWORD=StrongPassword@123

# After data.sql promotes Aarav to ADMIN (or after manual promotion),
# the same email is reused — but if your env has a different admin, set it here.
ADMIN_EMAIL=aarav@example.com
ADMIN_PASSWORD=StrongPassword@123

# Optional — for direct DB seeding/teardown
DB_HOST=localhost
DB_PORT=5432
DB_NAME=housing_owner_tenant
DB_USER=housing
DB_PASSWORD=housing

# Test flags
SKIP_VISUAL=false
SKIP_PERF=true
