NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
API_BASE_URL_INTERNAL=http://127.0.0.1:8080
# Use the Google web client ID from Google Cloud. The backend exchanges codes on
# /account/login/gmail and /account/register/gmail for local ports including 5678.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
HOSTNAME=0.0.0.0
PORT=5678
